# Copy to backend/.env for local development. Supply DATABASE_URL separately.
DJANGO_SECRET_KEY=replace-with-a-local-secret-of-at-least-50-characters
AUTH_TOKEN_PEPPER=replace-with-a-different-local-secret-of-at-least-32-characters
ACCOUNTS_OTP_HMAC_KEY=replace-with-an-independent-local-secret-of-at-least-32-characters
# Set exact, approved comma-separated Student.student_status values before OTP login.
ACCOUNTS_ACTIVE_STUDENT_STATUSES=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_DEFAULT_FROM_EMAIL=no-reply@btu.edu.ge
# Configure SMTP credentials outside source control before sending real email.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
# Durable Credential-to-Passport refresh worker defaults.
PASSPORT_REFRESH_LEASE_SECONDS=120
PASSPORT_REFRESH_MAX_ATTEMPTS=8
PASSPORT_REFRESH_RETRY_BASE_SECONDS=5

# Credential issuance uses this fixed internal issuer; never accept it from a request.
BTU_CLASSROOM_ISSUER_REFERENCE=BTU-UNIVERSITY
# Only list additional issuer references after an explicit institutional trust decision.
VERIFICATION_TRUSTED_ISSUER_REFERENCES=BTU-UNIVERSITY
BTU_AUTHORIZED_COMPLETION_SOURCES=
BTU_GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Production: DJANGO_DEBUG=false, explicit HTTPS origins/hosts, real independent keys.
# DATABASE_URL must be supplied securely; never commit its value.
