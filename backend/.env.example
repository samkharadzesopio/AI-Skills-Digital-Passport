# Copy to backend/.env for local development. Supply DATABASE_URL separately.
# For the guarded loopback database/file-mailbox profile, see ops/LOCAL_DEVELOPMENT.md.
# Start it with ops/start_local.ps1; normal config.settings keeps production TLS/SMTP checks.
DJANGO_SECRET_KEY=replace-with-a-local-secret-of-at-least-50-characters
AUTH_TOKEN_PEPPER=replace-with-a-different-local-secret-of-at-least-32-characters
ACCOUNTS_OTP_HMAC_KEY=replace-with-an-independent-local-secret-of-at-least-32-characters
# Set exact, approved comma-separated Student.student_status values before OTP login.
ACCOUNTS_ACTIVE_STUDENT_STATUSES=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_DEFAULT_FROM_EMAIL=no-reply@btu.edu.ge
# Configure SMTP credentials outside source control before sending real email.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
# Durable Credential-to-Passport refresh worker defaults.
PASSPORT_REFRESH_LEASE_SECONDS=120
PASSPORT_REFRESH_MAX_ATTEMPTS=8
PASSPORT_REFRESH_RETRY_BASE_SECONDS=5

# Credential issuance uses this fixed internal issuer; never accept it from a request.
BTU_CLASSROOM_ISSUER_REFERENCE=BTU-UNIVERSITY
# Only list additional issuer references after an explicit institutional trust decision.
VERIFICATION_TRUSTED_ISSUER_REFERENCES=BTU-UNIVERSITY
BTU_AUTHORIZED_COMPLETION_SOURCES=
BTU_GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Student GIS login only. Public Web Client ID; same as VITE_GOOGLE_CLIENT_ID.
# No Client Secret and no redirect URI. Separate from Sheets service accounts.
GOOGLE_OAUTH_CLIENT_ID=

# Optional flexible-source key -> server-approved target; never send this to React.
# Profile provisioning and explicit source approval are separate operator actions.
# Optional per-target "range": "A1:F50"; absent retains A1:Z5011 for compatibility.
# Use an absolute GOOGLE_SERVICE_ACCOUNT_FILE path outside every Git checkout.
# See ops/GOOGLE_SHEETS_LIVE.md. Never put credentials in VITE_* settings.
BTU_SPREADSHEET_GOOGLE_SOURCES_JSON={}
# Production: DJANGO_DEBUG=false, explicit HTTPS origins/hosts, real independent keys.
# DATABASE_URL must be supplied securely; never commit its value.

# Blockchain confirmation is required for verified issuance. The primary MVP
# environment is local Anvil (loopback RPC, chain 31337); configure its actual
# deployed registry and local-only issuer before enabling. Amoy is not required
# for this handoff. Unconfigured proofs NEVER verify.
# See ops/BACKEND_ANVIL_LOCAL_RUNBOOK.md for guarded local operation.
PASSPORT_BLOCKCHAIN_ENABLED=false
PASSPORT_BLOCKCHAIN_RPC_URL=
PASSPORT_BLOCKCHAIN_CHAIN_ID=
PASSPORT_BLOCKCHAIN_CONTRACT_ADDRESS=
PASSPORT_BLOCKCHAIN_ISSUER_ADDRESS=
# Restricted file outside this repository; never place a private key in source/env examples.
PASSPORT_BLOCKCHAIN_SIGNING_KEY_FILE=
PASSPORT_BLOCKCHAIN_CONFIRMATIONS=3
PASSPORT_BLOCKCHAIN_MAX_GAS_PRICE_WEI=50000000000
PASSPORT_IDENTITY_EVIDENCE_SOURCES=
