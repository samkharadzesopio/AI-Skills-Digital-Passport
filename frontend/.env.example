# Copy to frontend/.env.local and set true to preview all mock workspaces.
# Dev server only; always off in builds. No login or official actions.
VITE_ENABLE_DEMO=false
VITE_GOOGLE_CLIENT_ID=

# Set only once the actual Django API deployment is confirmed.
# VITE_API_BASE_URL=/api/

# Same-origin Django public PostgreSQL registries are enabled by default.
# Set false to disable requests; an explicitly empty source list also fails closed.
VITE_PUBLIC_VERIFICATION_ENABLED=true
# Exact serializer source labels. Issuer trust is enforced by Django, not this list.
# Simulated responses remain rejected. These labels do not assert blockchain proof.
VITE_PUBLIC_VERIFICATION_SOURCES=POSTGRESQL_CREDENTIAL_REGISTRY,POSTGRESQL_PASSPORT_REGISTRY,POSTGRESQL_DOCUMENT_REGISTRY
