# Copy to frontend/.env.local and set true to preview all mock workspaces.
# Dev server only; always off in builds. No login or official actions.
VITE_ENABLE_DEMO=false

# Set only once the actual Django API deployment is confirmed.
# VITE_API_BASE_URL=/api/

# Public verification stays disconnected until Django uses an approved real registry.
# The older checkout uses simulated sources. Integration cc74833 adds PostgreSQL registries.
VITE_PUBLIC_VERIFICATION_ENABLED=false
# Comma-separated source identifiers confirmed by the university backend team.
# Leave empty until a real source contract is approved; never add simulated sources.
# For a confirmed integration deployment, the published sources are:
# POSTGRESQL_PASSPORT_REGISTRY,POSTGRESQL_DOCUMENT_REGISTRY
VITE_PUBLIC_VERIFICATION_SOURCES=
